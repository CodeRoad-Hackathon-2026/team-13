# Copy to db/.env (or set DATABASE_URL in your shell) before running the migrator.
# An exported DATABASE_URL always wins over this file.

# --- local: matches the credentials in db/docker-compose.yml -----------------
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident_response

# --- Supabase ---------------------------------------------------------------
# Project Settings > Database > Connection string. The password is the database
# password you set when creating the project, NOT the anon or service_role key.
#
# Prefer the Session pooler (port 5432 on the pooler host): it is reachable over
# IPv4 and keeps one backend per connection, which is what a long-lived asyncpg
# pool wants. The Transaction pooler (6543) also works — app/db.py turns off
# asyncpg's statement cache when it sees a pooler host — but gives up session
# state. The Direct connection (db.<ref>.supabase.co) is IPv6-only on projects
# created without the IPv4 add-on, so it fails on most home and office networks.
#
# Note the username is postgres.<project-ref>, not plain postgres.
#
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# If the password contains @ : / ? # or %, percent-encode it or the URL parses
# into the wrong host and the failure looks like a network problem.
