# ---- database --------------------------------------------------------------
# Leave unset to use the Postgres in docker-compose.yml, which sets DATABASE_URL
# on the containers itself. Set it to point the orchestrator at a managed
# database instead — see db/SUPABASE.md for the Supabase walkthrough.
#
# Supabase: Project Settings > Database > Connection string, session pooler
# (port 5432). The username is postgres.<project-ref>, and the password is the
# database password, not the anon or service_role key.
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Supabase's pooler allots a fixed number of client connections per project, so
# the default max of 20 is worth lowering if anything else shares the database.
# DATABASE_POOL_MAX_SIZE=10

# One key for the whole stack. RAG Core registers it on first boot with admin
# scope, and the orchestrator authenticates with the same value — which is why
# ingestion (a `write` scope call) works without a second credential.
#
# It never reaches a browser: only the orchestrator talks to the RAG, and nginx
# exposes just the dashboard and /api.
RAG_API_KEY=rag_sk_change_me

# Encrypts connector credentials entered through RAG Core's setup UI
# (AES-256-GCM). Generate one with:
#
#   python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
#
# Empty means the vault is off: adding a source then needs its token in this file
# and a worker restart, rather than a form. Set it before entering any
# credential — changing it later leaves every stored secret undecryptable.
SECRETS_KEY=

# ---- providers -------------------------------------------------------------
# RAG Core is the only service that talks to a model. The orchestrator carries no
# LLM SDK at all — its agents generate through the RAG's /v1/answer — so these
# are the only provider credentials the stack needs. Without them it starts but
# cannot embed or answer: retrieval finds nothing and every agent abstains.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=

EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# The judge uses the same provider as generation; a model from another vendor
# here 404s. Blank reuses LLM_MODEL.
JUDGE_MODEL=
RERANK_PROVIDER=voyage
RERANK_ENABLED=true

# All-OpenAI alternative. RERANK_PROVIDER is the trap: OpenAI ships no reranker,
# so it has to be `none`, or `llm` to rerank with LLM_MODEL at the cost of
# tokens. Left on `voyage` without a Voyage key, ingestion fails *after*
# embedding already succeeded — a confusing place to find a missing credential.
#
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-3-large
#   EMBEDDING_DIM=1024
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#   JUDGE_MODEL=gpt-4.1-mini
#   RERANK_PROVIDER=none
#   RERANK_ENABLED=false
#
# Changing the embedder once documents exist needs
# POST /collections/incidents/reembed: stored vectors are model-specific, and a
# mixed collection ranks by nothing meaningful.

# Below this confidence RAG Core abstains instead of guessing. Measured, not
# chosen — on text-embedding-3-large the gap between answerable and
# unanswerable questions is [0.427, 0.531]. Re-derive it with `make eval` in
# rag-core whenever the embedding model or the corpus changes; a stale threshold
# fails in the expensive direction, letting out-of-corpus questions reach the
# model.
MIN_CONTEXT_SCORE=0.48

# Host ports, kept in one range so a deployment only has to check one block for
# collisions. Only the frontend really needs to be reachable; the others are
# published to make debugging with curl and psql possible.
FRONTEND_PORT=8900
ORCHESTRATOR_PORT=8901
RAG_PORT=8902
POSTGRES_PORT=8903

# Origins allowed to call the orchestrator directly. The dashboard is served
# same-origin through nginx and needs none of these, so this only matters when
# something other than the SPA calls the API from a browser. Follows
# FRONTEND_PORT by default.
# CORS_ORIGINS=["http://localhost:8900"]

# Orchestrator behaviour.
RETRIEVAL_TOP_K=8
# Above this similarity an incident counts as previously seen. Calibrate it per
# embedding model: on text-embedding-3-large, an incident matched against the
# runbook that actually covers it scored 0.49–0.56, so anything above ~0.6 leaves
# the flag permanently false and the funnel's "RAG match found" stage drops
# everything — with no error, just empty results.
KNOWN_INCIDENT_THRESHOLD=0.50
LOG_LEVEL=INFO

# ---- change delivery -------------------------------------------------------
# Which repositories an approved code change may be pushed to. Empty means none:
# nothing is delivered until a repository is listed deliberately.
# CHANGE_DELIVERY_ALLOWED_REPOS=["acme/payments-api"]

# Dry run by default — clone, apply and commit, but stop before pushing.
CHANGE_DELIVERY_PUSH_ENABLED=false

# A passphraseless deploy key with write access to those repositories. Prefer a
# per-repository deploy key over a personal one: anything that can execute in the
# orchestrator can use it, and this container already runs both HTTP requests and
# git operations authored by a language model.
# CHANGE_DELIVERY_SSH_KEY=/absolute/path/to/deploy_key    # chmod 600
