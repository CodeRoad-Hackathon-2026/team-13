# ------------------------------------------------------------------- runtime
# Comments live on their own line: some dotenv parsers keep trailing text as
# part of the value.
ENVIRONMENT=local
LOG_LEVEL=INFO
AUTH_ENABLED=true
# Registered as an admin key on startup so a fresh stack is immediately usable.
BOOTSTRAP_API_KEY=rag_sk_change_me_before_the_demo

# Encrypts connector credentials entered through the setup UI (AES-256-GCM).
# Generate with `make secrets-key`. Leave it empty and the vault is disabled:
# connectors then resolve ${VAR} from the worker environment only, which means
# adding a source needs an .env edit and a worker restart.
#
# Losing this key does not lose the sources — only the stored tokens, which
# then have to be re-entered. Changing it makes every existing secret fail to
# decrypt with a clear error rather than a corrupt token.
SECRETS_KEY=

# ------------------------------------------------------------------ storage
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
# Postgres text-search configuration for the lexical branch.
# 'simple' handles mixed-language corpora and identifiers (service names, error
# codes) best. Use 'spanish' / 'english' for single-language prose.
# Changing this requires re-running the migration on an empty schema.
FTS_CONFIG=simple

# --------------------------------------------------------------- providers
# Swapping vendors means changing the provider name and the matching token.
# EMBEDDING_PROVIDER: voyage | openai | ollama | hash
# `hash` is an offline stub for demos and tests — no semantics, no key.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
# Must match the model. Changing it requires POST /collections/{name}/reembed.
EMBEDDING_DIM=1024

# LLM_PROVIDER: anthropic | openai | ollama
# Measure TTFT with your real prompt before choosing — see the README.
# Working OpenAI combo: LLM_MODEL=gpt-4o, JUDGE_MODEL=gpt-4.1-mini,
# EMBEDDING_MODEL=text-embedding-3-large with EMBEDDING_DIM=512.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# The judge uses the same provider as generation. Leave blank to reuse
# LLM_MODEL — setting a model from a different vendor here will 404.
JUDGE_MODEL=
JUDGE_EFFORT=low

# RERANK_PROVIDER: voyage | cohere | llm | none
RERANK_PROVIDER=voyage
RERANK_MODEL=rerank-2.5
RERANK_ENABLED=true

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --------------------------------------------------------------- retrieval
# Candidates pulled per branch (vector, lexical) before fusion.
RETRIEVAL_CANDIDATES=60
# Passages handed to the generator.
RETRIEVAL_TOP_K=8
RERANK_CANDIDATES=30
RRF_K=60
VECTOR_WEIGHT=1.0
LEXICAL_WEIGHT=1.0
FEEDBACK_WEIGHT=0.15

# -------------------------------------------------------- anti-hallucination
# Below this confidence the API abstains instead of guessing.
#
# This value is measured, not chosen. `make eval` reports the confidence of
# questions the corpus can answer against those it cannot, and the threshold
# belongs in the gap between them. On the seeded corpus with
# text-embedding-3-large that gap is [0.427, 0.531], hence 0.48.
#
# Re-derive it whenever the embedding model or the corpus changes — both move
# the distributions, and a stale threshold fails silently in the expensive
# direction: out-of-corpus questions reach the model.
MIN_CONTEXT_SCORE=0.48
REQUIRE_CITATIONS=true
# Reject /answer calls with no incident_id. On because the correlation id is
# what makes a whole incident reconstructable through
# GET /v1/incidents/{id}/traces — an agent that forgets it produces a trace
# nobody can find, and that loss is invisible until someone audits.
# Set false for exploratory use where no incident exists.
REQUIRE_INCIDENT_ID=true
GROUNDEDNESS_CHECK=true
MIN_GROUNDEDNESS_SCORE=0.6

# ----------------------------------------------------------------- chunking
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# ------------------------------------------------------------------ worker
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=3

# ------------------------------------------------------- connector secrets
# Referenced from source configs as ${VAR_NAME} and resolved by the worker at
# poll time, so tokens are never stored in Postgres. See docs/sources.md.
JIRA_API_TOKEN=
CONFLUENCE_API_TOKEN=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
PAGERDUTY_TOKEN=
# AWS uses the default credential chain (IAM role / env / ~/.aws) unless the
# source config overrides it.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------- MCP server
RAG_API_URL=http://localhost:8000/v1
RAG_API_KEY=

# --------------------------------------------------------------- CrewAI crew
# The crew routes through litellm, so its model is configured independently of
# the service's providers. See agents/README.md.
CREW_MODEL=anthropic/claude-opus-5
