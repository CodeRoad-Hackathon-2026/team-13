# Secrets. The vault key and every vendor token live here — never commit it.
.env
.env.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/

# Build output. Regenerate with `make ui`; committing it guarantees that one
# day the bundle and the source it came from disagree.
frontend/dist/

# data/runbooks is committed: 4 KB of demo material the `filesystem` connector
# points at, so the demo works from a fresh clone. data/sql-repo is a nested
# git repository used as a local remote by the `git_repo` connector — tracking
# it would create a gitlink, and it is regenerable.
data/*
!data/runbooks/
data/sql-repo/

.DS_Store
